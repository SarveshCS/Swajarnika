# Swajarnika environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-manage.py
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Akash LLM API (https://chatapi.akash.network)
AKASH_API_KEY=sk-your-key-here
AKASH_API_BASE=https://chatapi.akash.network/api/v1
AKASH_MODEL=Meta-Llama-3-1-8B-Instruct-FP8
